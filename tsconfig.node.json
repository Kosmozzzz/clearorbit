{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "research/**/*.ts", "src/utils/screening/orbit.ts", "src/utils/screening/population.ts", "src/utils/screening/random.ts", "src/utils/screening/screen.ts", "src/utils/deorbit.ts", "src/utils/removal.ts", "src/utils/kessler.ts", "src/utils/economics.ts", "src/utils/cascadeSim.ts"]
}
